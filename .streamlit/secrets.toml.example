# ==============================================================================
# Streamlit Community Cloud Secrets 設定範本 (.streamlit/secrets.toml)
# 在 Streamlit Cloud 後台 -> 點擊 App 的 "..." -> "Settings" -> "Secrets" 貼上以下內容
# ==============================================================================

# [推薦方案] Supabase / PostgreSQL 雲端外部資料庫連線
# 到 supabase.com 建立免費專案 -> Project Settings -> Database -> Connection string (URI)
# 複製 URI (記得將 [YOUR-PASSWORD] 換成您的資料庫密碼)
[connections.postgresql]
url = "postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# 備用：若使用 Supabase API 格式
[supabase]
db_url = "postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
